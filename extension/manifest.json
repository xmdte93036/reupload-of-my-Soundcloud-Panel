{
  "manifest_version": 3,
  "name": "SoundCloud Mini Player",
  "version": "3.2.0",
  "description": "Bridges SoundCloud and Spotify in the browser to the desktop mini player.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://soundcloud.com/*",
    "https://open.spotify.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://soundcloud.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content-spotify.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SoundCloud Mini Player Themes"
  },
  "web_accessible_resources": [
    {
      "resources": ["mini-player.html", "themes.css"],
      "matches": ["https://soundcloud.com/*", "https://open.spotify.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
